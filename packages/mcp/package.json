{
  "name": "@aldus-palace/mcp",
  "version": "0.6.3",
  "description": "Trustworthy context for Claude, Cursor and any MCP client — capture, Today, memory and action tools over a SQLite file you own.",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/heymi/aldus-palace.git",
    "directory": "packages/mcp"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude",
    "agent",
    "personal-knowledge"
  ],
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "aldus-palace-mcp": "./dist/index.js",
    "aldus-palace-mcp-capture": "./dist/index.js",
    "aldus-palace-mcp-today": "./dist/index.js",
    "aldus-palace-mcp-workstreams": "./dist/index.js",
    "aldus-palace-mcp-memory": "./dist/index.js",
    "aldus-palace-mcp-actions": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "start": "tsx src/index.ts",
    "test": "tsx test/tools.test.ts"
  },
  "dependencies": {
    "@aldus-palace/core": "workspace:^",
    "@modelcontextprotocol/sdk": "^1.20.0",
    "better-sqlite3": "^12.11.1",
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.14.1",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3"
  }
}
