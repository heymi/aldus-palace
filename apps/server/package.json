{
  "name": "@aldus-palace/server",
  "version": "0.1.7",
  "private": true,
  "description": "The HTTP surface of the context layer — one schema, a local SQLite file or a Cloudflare Durable Object.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx src/db/migrate-cli.ts",
    "cf:types": "wrangler types",
    "cf:dev": "wrangler dev",
    "cf:deploy": "wrangler deploy",
    "test": "tsx test/run-tests.ts"
  },
  "dependencies": {
    "@aldus-palace/core": "workspace:^",
    "@hono/node-server": "^1.14.1",
    "better-sqlite3": "^12.11.1",
    "dotenv": "^16.5.0",
    "hono": "^4.7.7",
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.14.1",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "wrangler": "^4.112.0"
  }
}
