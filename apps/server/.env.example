PORT=8787
HOST=127.0.0.1
DATABASE_PATH=./data/aldus.db

# --- LLM -------------------------------------------------------------------
# dev      = deterministic local rules only (offline, no key)
# deepseek = OpenAI-compatible DeepSeek endpoint (needs DEEPSEEK_API_KEY)
# auto     = use DeepSeek when a key is present, otherwise dev
LLM_PROVIDER=auto
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Any other OpenAI-compatible endpoint:
# LLM_PROVIDER=openai-compatible
# OPENAI_COMPATIBLE_API_KEY=
# OPENAI_COMPATIBLE_BASE_URL=https://api.openai.com
# OPENAI_COMPATIBLE_MODEL=gpt-4o-mini

# --- Auth ------------------------------------------------------------------
# Single-user bearer token for /v1/*. Change it before exposing the server.
DEV_AUTH_TOKEN=dev-local-token
DEV_USER_NAME=Local User
DEV_USER_TIMEZONE=Asia/Tokyo
DEV_USER_LANGUAGE=en
