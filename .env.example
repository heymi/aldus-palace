# Copy to `.env` for docker compose, then edit.
#
#   cp .env.example .env && docker compose up --build

# CHANGE THIS. It is the only thing between your data and anyone who can reach
# the port.
DEV_AUTH_TOKEN=dev-local-token

# dev | anthropic | deepseek | openai-compatible
LLM_PROVIDER=dev

# Redaction before any cloud call:
# 0 raw | 1 project names | 2 + money | 3 + email/phone | 4 never leaves the device
PRIVACY_LEVEL=2
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
DEEPSEEK_API_KEY=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_MODEL=

DEV_USER_NAME=Local User
DEV_USER_TIMEZONE=UTC
DEV_USER_LANGUAGE=en
