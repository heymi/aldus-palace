{
  "name": "aldus-palace",
  "private": true,
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter @aldus-palace/core build && pnpm --filter @aldus-palace/server dev",
    "start": "pnpm --filter @aldus-palace/server start",
    "demo": "pnpm --filter @aldus-palace/core build && pnpm --filter @aldus-palace/example-capture-cli start",
    "verify": "pnpm typecheck && pnpm test && pnpm eval && pnpm bench && pnpm build && pnpm spec:check && pnpm openapi:check && pnpm llms:check && pnpm check:docs",
    "bench": "pnpm --filter @aldus-palace/core bench",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "eval": "pnpm --filter @aldus-palace/core eval",
    "gen:spec": "node scripts/gen-spec.mjs",
    "spec:check": "node scripts/gen-spec.mjs --check",
    "gen:openapi": "node scripts/gen-openapi.mjs",
    "openapi:check": "node scripts/gen-openapi.mjs --check",
    "gen:llms": "node scripts/gen-llms-full.mjs",
    "llms:check": "node scripts/gen-llms-full.mjs --check",
    "check:docs": "node scripts/check-docs.mjs",
    "evidence": "node scripts/capture-evidence.mjs",
    "changeset": "changeset",
    "release": "pnpm build && changeset publish",
    "cf:types": "pnpm --filter @aldus-palace/server cf:types"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "@changesets/cli": "^2.27.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "workerd"
    ]
  }
}
